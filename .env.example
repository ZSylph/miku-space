# ── 数据库 ──
# 本地开发: SQLite 文件路径
# 生产部署: Turso libSQL 连接串 (libsql://xxx.turso.io)
DATABASE_URL="file:./dev.db"

# Turso 认证令牌（生产环境必填）
# 通过 turso db tokens create <db-name> 生成
DATABASE_AUTH_TOKEN=""

# ── 站点 ──
# 用于 RSS、Sitemap、OG 标签等生成绝对链接
# 本地开发保持默认值，部署时改为实际域名
SITE_URL="http://localhost:3000"

# ── 管理后台认证 ──
# 用户名
ADMIN_USERNAME="admin"

# 密码哈希 — 通过以下命令生成:
# npx tsx -e "console.log(require('./lib/auth').hashPassword('your-password'))"
ADMIN_PASSWORD_HASH=""

# 随机密钥 — 用于签名 session cookie，建议 64 位 hex 字符串
# 可通过以下命令生成:
# npx tsx -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=""

# ── Cloudflare R2 对象存储（生产环境）──
# 本地开发无需配置，文件会保存到 public/uploads/
# 部署时填写 R2 的 S3 兼容 API 信息
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="miku-uploads"
# R2 公共访问地址（自定义域名或 R2 公开 URL）
R2_PUBLIC_URL=""
