# ── 数据库（仅本地开发）──
# 本地开发使用 SQLite 文件，生产环境通过 Cloudflare D1 binding 连接
DATABASE_URL="file:./dev.db"

# ── 站点 ──
# 用于 RSS、Sitemap、OG 标签等生成绝对链接
# 本地开发保持默认值，部署时在 wrangler.jsonc vars 中配置
SITE_URL="http://localhost:3000"

# ── 管理后台认证 ──
# 用户名
ADMIN_USERNAME="admin"

# 密码哈希 — 通过以下命令生成:
# npx tsx -e "console.log(require('./lib/auth').hashPassword('your-password'))"
ADMIN_PASSWORD_HASH=""

# 随机密钥 — 用于签名 session cookie，建议 64 位 hex 字符串
# 可通过以下命令生成:
# npx tsx -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=""

# ── Cloudflare R2（仅本地开发测试用）──
# 生产环境通过 wrangler.jsonc 的 r2_buckets binding 和 secrets 配置
# 本地开发无需配置，文件会保存到 public/uploads/
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="miku-uploads"
R2_PUBLIC_URL=""
